{
  "info": {
    "name": "De Vinci Recruit API Tests",
    "description": "Lab 6: in-memory association profiles CRUD. Run requests in order; POST saves associationId for GET, PUT and DELETE. Restarting the server resets sample data. POST and PUT require all four profile fields; IDs are server-generated. Logo URLs are placeholders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET associations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/associations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "associations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is a JSON array', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "",
              "pm.test('Association objects contain the required fields', function () {",
              "  const associations = pm.response.json();",
              "  pm.expect(associations).to.be.an('array').that.is.not.empty;",
              "  associations.forEach(function (association) {",
              "    pm.expect(association).to.have.all.keys('id', 'name', 'description', 'category', 'logoUrl');",
              "    pm.expect(association.id).to.be.a('number');",
              "    ['name', 'description', 'category', 'logoUrl'].forEach(function (field) {",
              "      pm.expect(association[field]).to.be.a('string').that.is.not.empty;",
              "    });",
              "  });",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "POST association",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/associations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "associations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"De Vinci Art Club\",\n  \"description\": \"Students creating art together.\",\n  \"category\": \"Arts\",\n  \"logoUrl\": \"https://example.com/logos/art-club.png\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('associationId', pm.response.json().id); }"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "GET association by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/associations/{{associationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "associations",
            "{{associationId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "PUT association",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/associations/{{associationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "associations",
            "{{associationId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"De Vinci Art Club\",\n  \"description\": \"Updated art club profile.\",\n  \"category\": \"Arts\",\n  \"logoUrl\": \"https://example.com/logos/art-club.png\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "DELETE association",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/associations/{{associationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "associations",
            "{{associationId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "associationId",
      "value": "1",
      "type": "string"
    }
  ]
}
