    {
      "name": "Recruitment Decisions (DEMO authentication only)",
      "description": "Run in order. Uses the existing /applications dataset. Demo headers are spoofable and provide no production security or association membership validation.",
      "item": [
        {
          "name": "Create application for decisions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Martin\",\n  \"email\": \"decision-{{decisionRunId}}@example.com\",\n  \"year\": 3,\n  \"major\": \"Engineering\",\n  \"motivation\": \"I would like to contribute to association projects.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('decisionRunId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('applicationId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Decision: accepted",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Demo-Role",
                "value": "president"
              },
              {
                "key": "X-Demo-User-Id",
                "value": "{{demoPresidentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"accepted\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Decision status', function () { pm.expect(pm.response.json().status).to.eql('accepted'); });",
                  "pm.test('No private notes', function () { pm.expect(pm.response.json()).to.have.all.keys('id', 'status', 'decidedBy', 'decidedAt'); });",
                  "pm.test('Final decision metadata', function () { const b = pm.response.json(); pm.expect(b.decidedBy).to.eql(pm.collectionVariables.get('demoPresidentId')); pm.expect(Number.isNaN(Date.parse(b.decidedAt))).to.eql(false); });"
                ]
              }
            }
          ],
          "response": []
        },
